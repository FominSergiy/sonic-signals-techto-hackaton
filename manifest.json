{
    "manifest_version": 3,
    "name": "Voice Command Browser",
    "version": "1.0",
    "description": "Control browser actions with custom voice commands",
    
    "permissions": [
      "activeTab",
      "tabs",
      "storage",
      "scripting"
    ],
    
    "host_permissions": [
      "<all_urls>"
    ],
  
    "background": {
      "service_worker": "background.js"
    },
  
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ],
  
    "action": {
      "default_popup": "popup.html",
      "default_title": "Voice Command Browser"
    },
  
    "options_page": "options.html",
  
    "web_accessible_resources": [
      {
        "resources": ["audio-processor.js"],
        "matches": ["<all_urls>"]
      }
    ]
  }