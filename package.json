{
  "name": "voice-command-ai-service",
  "version": "1.0.0",
  "description": "AI-powered audio command recognition service with Llama integration",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "test": "node test/test-service.js",
    "setup": "npm install && node setup/init-db.js",
    "docker": "docker-compose up -d"
  },
  "keywords": [
    "voice-commands",
    "ai",
    "llama",
    "audio-recognition",
    "websocket",
    "chrome-extension"
  ],
  "author": "Voice Command System",
  "license": "MIT",
  "dependencies": {
    "@tensorflow-models/universal-sentence-encoder": "^1.3.3",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@tensorflow/tfjs-node-gpu": "^4.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.2",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "node-wav": "^0.0.2",
    "sqlite3": "^5.1.6",
    "wav": "^1.0.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-repo/voice-command-ai-service"
  },
  "bugs": {
    "url": "https://github.com/your-repo/voice-command-ai-service/issues"
  },
  "homepage": "https://github.com/your-repo/voice-command-ai-service#readme",
  "config": {
    "port": 3001,
    "llama_endpoint": "http://localhost:11434",
    "model_name": "llama3.2",
    "confidence_threshold": 0.7
  }
}
